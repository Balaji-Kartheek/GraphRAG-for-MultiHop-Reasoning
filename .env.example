# Gemini (required for triple extraction)
GEMINI_API_KEY=your_gemini_api_key

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=article_embeddings
GEMINI_MODEL=gemini-2.0-flash

# Graph / retrieval
GRAPH_TRAVERSAL_DEPTH=3
TOP_K_VECTOR=5
CHUNK_SIZE=300
CHUNK_OVERLAP=50
CONFIDENCE_THRESHOLD=0.8

# Dynamic fetch (optional)
NEWS_API_KEY=
RSS_FEEDS=https://techcrunch.com/feed/,https://feeds.feedburner.com/venturebeat/SZYF
FETCH_LIMIT_PER_RUN=100
